  "description": "yomi database layer: Drizzle schema, migrations, PGlite or Postgres client, backups, v0.1 SQLite import.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averatec0773/yomi.git",
    "directory": "packages/db"
  },
  "private": true,
  "type": "module",
