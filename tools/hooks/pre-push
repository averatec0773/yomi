#!/bin/sh
# Rejects a push whose new commits add private paths or denylisted text (see tools/hooks/guard.sh).
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
root=$(git rev-parse --show-toplevel) || exit 1
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # deleting a remote ref
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *) range="$local_sha --not --remotes" ;; # new branch: commits no remote has yet
  esac
  # shellcheck disable=SC2086
  sh "$root/tools/hooks/guard.sh" commits $range || status=1
done
[ "$status" -eq 0 ] || echo "yomi guard: push rejected." >&2
exit $status
