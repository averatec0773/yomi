# yomi environment variables (all optional). Details: guides/configuration.md.
#
# Most people don't need this file: enter bank and brokerage credentials in Settings > Connections.
# Use it to manage configuration as code. A value set here wins over Settings and shows there as
# read-only. Copy to .env.local, fill in what you need, restart yomi.

# Ledger location. Unset: the embedded Postgres (PGlite) directory data/pglite.
# A path is a PGlite directory; postgres://user:password@host:5432/yomi is a Postgres server.
# DATABASE_URL=
# DATABASE_POOL_MAX=10

# Encryption key for stored credentials. Unset: created at ~/.config/yomi/secret.key.
# Back it up; without it saved credentials can't be read. Generate: pnpm secrets:gen-key
# YOMI_SECRET_KEY=

# Access token, required before exposing yomi beyond this computer. Generate: openssl rand -hex 32
# YOMI_ACCESS_TOKEN=

# Other names or addresses yomi answers to besides localhost (LAN, Tailscale), comma-separated.
# YOMI_ALLOWED_HOSTS=192.168.1.20,my-laptop

# Plaid bank sync (Plaid Dashboard > Developers > Keys). PLAID_ENV: sandbox or production.
# PLAID_CLIENT_ID=
# PLAID_SECRET_SANDBOX=
# PLAID_SECRET_PRODUCTION=
# PLAID_ENV=sandbox

# Interactive Brokers Flex Web Service
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY_ID=

# Advanced: YOMI_SECRET_KEY_FILE (key file path), LOCAL_MODE (default true),
# YOMI_BACKGROUND_SYNC (1 on, 0 off; default on for the default ledger only)
# The web port (default 7773) is not read from this file: run PORT=8000 pnpm dev, or pnpm dev -p 8000.
